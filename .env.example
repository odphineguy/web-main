# Groq API Key (for the text chatbot — Llama 3.3 70B)
# Copy this file to .env.local and replace with your actual API key.
# Free tier, no credit card required: https://console.groq.com/keys
# IMPORTANT: This key is server-side only (no NEXT_PUBLIC_ prefix).
GROQ_API_KEY=

# Server-only shared secret used by Next.js API routes when persisting form
# submissions to Convex. Set the same value in Vercel and Convex.
FORM_SUBMISSION_SECRET=

# Optional dedicated key for encrypting private AI audit report links. When
# omitted, FORM_SUBMISSION_SECRET is used with a separate derived key.
AI_AUDIT_REPORT_SECRET=

# Identity allowed to read lead-submission queries in Convex.
ADMIN_EMAIL=
